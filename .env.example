# Voice Engine Defaults
DEFAULT_VOICE=en-US-JennyNeural
VOICE_RATE=+0%
VOICE_PITCH=+0Hz

# Google Calendar API (Optional)
GOOGLE_CALENDAR_CREDENTIALS=
GOOGLE_CALENDAR_ID=primary
