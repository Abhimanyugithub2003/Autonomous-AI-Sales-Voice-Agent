# Server Configuration
PORT=8000
HOST=0.0.0.0

# Database (MongoDB)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=fortive_sales_ai

# LLM Providers (Optional - Agent includes native consultative engine fallback)
